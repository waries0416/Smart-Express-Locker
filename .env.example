# ============================================================================
# 智能快递柜管理系统 · 环境变量样例
# ----------------------------------------------------------------------------
# 用法：
#   1) 复制为 .env：  copy .env.example .env      (Windows)
#                     cp   .env.example .env      (macOS / Linux)
#   2) 按需填写，**不要**把 .env 提交到仓库（.gitignore 已忽略 .env / .env.*，
#      仅保留本文件 .env.example 入库）。
#   3) 本项目**不依赖 python-dotenv**：.env 不会自动加载。请用环境变量注入，例如
#        Windows PowerShell:  $env:DEEPSEEK_API_KEY="sk-xxx"; python backend/app.py
#        Linux/macOS:         export DEEPSEEK_API_KEY=sk-xxx; python backend/app.py
#
# 安全红线（违反即安全事故）：
#   · 本文件里的所有 Key 一律留空，**不得填写任何真实值**；
#   · 只有下面标注「可下发前端 ✅」的变量才会出现在 HTTP 响应里；
#   · 其余 Key（尤其 AMAP_WEB_KEY / ALIPAY_* / DEEPSEEK_API_KEY）永远只在服务端使用，
#     禁止写进前端代码、日志、截图。
#
# 全部变量未配置时系统仍可正常启动：四组创新功能各自自动降级
# （AI→本地规则、地图→按柜号排序、支付→模拟支付），业务接口不受影响。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、数据库（原有配置，非创新功能）
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_locker
# 连接池（S9 性能项）
DB_POOL_MAX=10
DB_POOL_MIN=1
DB_POOL_CACHED=5

# ---------------------------------------------------------------------------
# 二、AI 包装推荐与问答（创新点 1 · DeepSeek）
# ---------------------------------------------------------------------------
# DeepSeek API Key。留空 = 全部走本地规则引擎，接口仍返回 200（source="rule"）。
# 获取地址：https://platform.deepseek.com/api_keys
# ❌ 禁止下发前端
DEEPSEEK_API_KEY=
# API 基址（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名
DEEPSEEK_MODEL=deepseek-chat
# 单次调用超时（秒）
DEEPSEEK_TIMEOUT=8
# 最大重试次数（仅对超时 / 5xx / 429 重试）
DEEPSEEK_MAX_RETRY=2
# AI 总开关：0 = 强制走本地规则（演示"降级"效果时用）
AI_ENABLED=1

# ---------------------------------------------------------------------------
# 三、高德地图找柜（创新点 3 · AMap）
# ---------------------------------------------------------------------------
# 【Key 分级，务必区分】
#   AMAP_JS_KEY / AMAP_JS_SECURITY_CODE → 浏览器端 JS API 2.0 使用，
#        **可以下发前端**（GET /api/map/config 会返回），
#        但必须先在 高德控制台 → 应用管理 → 绑定域名白名单，否则不要下发。
#   AMAP_WEB_KEY → 服务端 Web 服务 API（地理编码/逆地理编码），
#        **绝对禁止下发前端**，接口只回一个布尔 web_service_available。

# JS API 2.0 Key（浏览器端加载地图）
# ✅ 可下发前端（需绑定域名白名单）
AMAP_JS_KEY=
# JS API 安全密钥 securityJsCode（与 JS Key 配套）
# ✅ 可下发前端（需绑定域名白名单）
AMAP_JS_SECURITY_CODE=
# Web 服务 Key（服务端地理编码 / 逆地理编码）
# ❌ 禁止下发前端，永不出现在任何响应或日志里
AMAP_WEB_KEY=
# 高德请求超时（秒）
AMAP_TIMEOUT=5

# ---------------------------------------------------------------------------
# 四、支付宝沙箱 / 模拟支付（创新点 4）
# ---------------------------------------------------------------------------
# 支付渠道：mock（默认，模拟支付，不产生真实扣款）| alipay（支付宝沙箱）
# 选 alipay 但下面三件凭据不全时，系统**自动回落 mock** 并在响应里 degraded=true，
# 绝不尝试真实扣款。
PAYMENT_PROVIDER=mock
# 支付单有效期（分钟）
PAYMENT_EXPIRE_MINUTES=10
# 寄件费单价（元）。超时保管费另有规则，默认每件 ¥1.00（与业务层一致）
SEND_FEE_YUAN=1.00

# 支付宝应用 ID（沙箱应用的 APPID）
# ❌ 禁止下发前端
ALIPAY_APP_ID=
# 应用私钥（RSA2，PKCS#8 PEM；可传单行 base64，程序会自动补 PEM 头尾）
# ❌ 禁止下发前端
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（RSA2，用于异步通知验签）
# ❌ 禁止下发前端
ALIPAY_PUBLIC_KEY=
# 1 = 使用沙箱网关（必须为 1 才会启用真实模式）
ALIPAY_SANDBOX=1
# 网关地址。留空 = 沙箱模式下自动用 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=
# 异步通知回调地址（需公网可达，例如 https://your-domain/api/pay/notify/alipay）
ALIPAY_NOTIFY_URL=

# ---------------------------------------------------------------------------
# 五、服务与页面（原有配置）
# ---------------------------------------------------------------------------
# Flask 监听端口
PORT=5000
# 管理端路径前缀（默认 admin → /admin/login）
ADMIN_PATH=admin
# 管理端 token 签名密钥（生产环境务必改成随机长串）
AUTH_SECRET=smart-locker-demo-secret
# HTTPS 部署时置 1，管理端 Cookie 加 Secure 标记
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# 六、消息通知（原有功能）
# ---------------------------------------------------------------------------
# 通知总开关
NOTIFY_ENABLED=1
# 后台投递线程开关（测试脚本可置 0，改为手动调 dispatch）
NOTIFY_WORKER=1
# 投递线程轮询间隔（秒）
NOTIFY_WORKER_INTERVAL=15
# 渠道：SMS / INBOX / PUSH，逗号分隔
NOTIFY_CHANNELS=SMS,INBOX,PUSH
# 短信服务商：mock = 写日志不真发
NOTIFY_SMS_PROVIDER=mock
# 模拟发送失败概率（0~1），用于演示失败重试
NOTIFY_FAIL_RATE=0

# ---------------------------------------------------------------------------
# 七、手机端 H5（原有功能）
# ---------------------------------------------------------------------------
# 1 = 演示模式，验证码在响应里回显；接入真实短信后置 0
MOBILE_DEV_MODE=1
# 内网穿透公网地址（手机扫码可跨网段打开），留空则自动探测局域网 IP
PUBLIC_BASE_URL=
